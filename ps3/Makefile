# Chiaki-ng PS3 port (PSL1GHT)
#
#   export PS3DEV=/usr/local/ps3dev PSL1GHT=$PS3DEV
#   make            -> chiaki-ps3.elf / .self
#   make pkg        -> chiaki-ps3.pkg (install with Package Manager)

ifeq ($(strip $(PSL1GHT)),)
$(error "Please set PSL1GHT in your environment. export PSL1GHT=<path>")
endif

include $(PSL1GHT)/ppu_rules

TARGET    := chiaki-ps3
TITLE     := Chiaki-ng PS3
APPID     := CHIAKIPS3
CONTENTID := UP0001-$(APPID)_00-0000000000000000
BUILDDIR  := $(CURDIR)/build
# XMB artwork (generated by tools/gen_icons.py): icon and background
ICON0     := $(CURDIR)/pkgfiles/ICON0.PNG
PKGFILES  := $(CURDIR)/pkgfiles

ROOT      := $(abspath $(CURDIR)/..)
LIBDIR    := $(ROOT)/lib
TP        := $(ROOT)/third-party
OPUS      := $(CURDIR)/third-party/opus

# ---------------------------------------------------------------------------
# chiaki core (LAN + PSN internet holepunch via mbedTLS, no AIA/ffmpeg)
CHIAKI_SRC := $(filter-out \
	$(LIBDIR)/src/aia.c $(LIBDIR)/src/aia_openssl.c \
	$(LIBDIR)/src/ffmpegdecoder.c $(LIBDIR)/src/pidecoder.c, \
	$(wildcard $(LIBDIR)/src/*.c)) \
	$(LIBDIR)/src/remote/holepunch.c \
	$(LIBDIR)/src/remote/rudp.c \
	$(LIBDIR)/src/remote/rudpsendbuffer.c \
	$(BUILDDIR)/gen/takion.pb.c

NANOPB_SRC := $(TP)/nanopb/pb_common.c $(TP)/nanopb/pb_encode.c $(TP)/nanopb/pb_decode.c

GF_SRC := $(addprefix $(TP)/gf-complete/src/, gf.c gf_wgen.c gf_w4.c gf_w8.c gf_w16.c \
	gf_w32.c gf_w64.c gf_w128.c gf_rand.c gf_general.c gf_cpu.c)
JERASURE_SRC := $(addprefix $(TP)/jerasure/src/, galois.c jerasure.c reed_sol.c cauchy.c liberation.c)

include $(OPUS)/celt_sources.mk
include $(OPUS)/silk_sources.mk
include $(OPUS)/opus_sources.mk
OPUS_SRC := $(addprefix $(OPUS)/, $(CELT_SOURCES) $(SILK_SOURCES) $(SILK_SOURCES_FLOAT) \
	$(OPUS_SOURCES) $(OPUS_SOURCES_FLOAT))

APP_SRC := $(wildcard $(CURDIR)/src/*.c)

ALL_SRC := $(CHIAKI_SRC) $(NANOPB_SRC) $(GF_SRC) $(JERASURE_SRC) $(OPUS_SRC) $(APP_SRC)
OBJS    := $(patsubst $(ROOT)/%.c,$(BUILDDIR)/obj/%.o,$(filter-out $(BUILDDIR)/%,$(ALL_SRC))) \
	$(BUILDDIR)/obj/gen/takion.pb.o

# ---------------------------------------------------------------------------
INCLUDE := -include $(CURDIR)/compat/ps3_compat.h -I$(CURDIR)/compat -I$(BUILDDIR)/gen -I$(BUILDDIR)/include \
	-I$(LIBDIR)/include -I$(LIBDIR)/src \
	-I$(TP)/nanopb -I$(TP)/gf-complete/include -I$(TP)/jerasure/include \
	-I$(OPUS)/include -I$(OPUS)/celt -I$(OPUS)/silk -I$(OPUS)/silk/float -I$(OPUS) \
	-I$(PORTLIBS)/include $(LIBPSL1GHT_INC)

DEFINES := -D__PS3__ -DCHIAKI_LIB_ENABLE_MBEDTLS -DPB_C99_STATIC_ASSERT \
	-DOPUS_BUILD -DUSE_ALLOCA -DHAVE_LRINTF -DHAVE_LRINT -DVAR_ARRAYS=0

CFLAGS  := -O2 -g -Wall -mcpu=cell $(MACHDEP) $(INCLUDE) $(DEFINES)
LDFLAGS := $(MACHDEP) -Wl,-Map,$(BUILDDIR)/$(TARGET).map -L$(PORTLIBS)/lib $(LIBPSL1GHT_LIB)
LIBS    := -lmbedtls -lmbedx509 -lmbedcrypto \
	-lvdec -laudio -lio -lrsx -lgcm_sys -lsysutil -lnet -lnetctl -lsysmodule -lrt -llv2 -lm

.PHONY: all pkg clean
all: $(TARGET).self

pkg: $(TARGET).pkg

$(BUILDDIR)/include/chiaki/config.h:
	@mkdir -p $(dir $@)
	@printf '#ifndef CHIAKI_CONFIG_H\n#define CHIAKI_CONFIG_H\n#define CHIAKI_LIB_ENABLE_OPUS 1\n#define CHIAKI_LIB_ENABLE_PI_DECODER 0\n#define CHIAKI_LIB_ENABLE_FFMPEG_DECODER 0\n#endif\n' > $@

# protobuf (needs protoc and python3-protobuf on the build host)
PROTOC  ?= protoc
PYTHON  ?= python3
$(BUILDDIR)/gen/takion.pb.c: $(LIBDIR)/protobuf/takion.proto
	@mkdir -p $(dir $@)
	$(PROTOC) -o$(BUILDDIR)/gen/takion.pb -I$(LIBDIR)/protobuf $<
	cd $(BUILDDIR)/gen && $(PYTHON) $(TP)/nanopb/generator/nanopb_generator.py takion.pb

$(BUILDDIR)/obj/gen/takion.pb.o: $(BUILDDIR)/gen/takion.pb.c $(BUILDDIR)/include/chiaki/config.h
	@mkdir -p $(dir $@)
	$(VERB) $(CC) $(CFLAGS) -c $< -o $@

$(CHIAKI_SRC:$(ROOT)/%.c=$(BUILDDIR)/obj/%.o) $(APP_SRC:$(ROOT)/%.c=$(BUILDDIR)/obj/%.o): $(BUILDDIR)/gen/takion.pb.c

$(BUILDDIR)/obj/%.o: $(ROOT)/%.c $(BUILDDIR)/include/chiaki/config.h
	@mkdir -p $(dir $@)
	@echo CC $(notdir $<)
	$(VERB) $(CC) $(CFLAGS) -MMD -c $< -o $@

$(TARGET).elf: $(OBJS)
	@echo LD $@
	$(VERB) $(CC) $(LDFLAGS) $(OBJS) $(LIBS) -o $@

clean:
	rm -rf $(BUILDDIR) $(TARGET).elf $(TARGET).self $(TARGET).fake.self $(TARGET)*.pkg

-include $(OBJS:.o=.d)
